{
  "name": "agent-receipt-kit",
  "version": "0.1.0",
  "description": "Verify AI agent claims against issued authority and independent state, then bind JSON evidence records to deterministic canonical SHA-256 envelopes. Zero-dependency, framework-agnostic TypeScript.",
  "keywords": [
    "agent",
    "ai-agent",
    "agent-observability",
    "agent-trust",
    "verification",
    "receipt",
    "authorization",
    "audit-trail",
    "evidence-packet",
    "canonical-json",
    "sha256",
    "integrity"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  }
}
