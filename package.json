{
  "name": "agent-receipt-kit",
  "version": "0.1.0",
  "description": "A dependency-free TypeScript contract for checking an AI agent's claimed work against its authorization and independent evidence.",
  "keywords": [
    "agent",
    "ai-agent",
    "agent-observability",
    "agent-trust",
    "verification",
    "receipt",
    "authorization",
    "audit-trail"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkopietz3-byte/agent-receipt-kit.git"
  },
  "homepage": "https://github.com/lkopietz3-byte/agent-receipt-kit#readme",
  "bugs": {
    "url": "https://github.com/lkopietz3-byte/agent-receipt-kit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  }
}
